{
  "name": "@vms/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema, migrations and client (Drizzle ORM)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./migrator": "./src/migrator.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vms/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
