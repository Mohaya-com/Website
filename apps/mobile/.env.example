# Copy to apps/mobile/.env
# Base URL of the shared backend (the Next.js web app). On a physical device use your computer's LAN IP,
# e.g. http://192.168.1.20:3000 — "localhost" refers to the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Optional — required for push notifications and EAS builds (see README).
EAS_PROJECT_ID=
IOS_BUNDLE_ID=com.example.compoundvms
ANDROID_PACKAGE=com.example.compoundvms
# Domain used for universal links / Android app links (same host as the web app).
APP_LINK_HOST=
