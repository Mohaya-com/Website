# Production settings for deploy/docker-compose.yml
#   cd deploy && cp .env.example .env && nano .env
# Generate each secret separately:   openssl rand -base64 48
# Never commit the real .env file.

# ── Domain and HTTPS ──────────────────────────────────────────────
# The public domain (without https://). Its DNS A record must point to this server.
DOMAIN=vms.example.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.com

# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_POOL_MAX=10
# Days to keep the daily backups in deploy/backups
BACKUP_KEEP_DAYS=14

# ── Secrets (required, at least 32 characters each, all different) ─────
PASS_TOKEN_SECRET=
OTP_SECRET=

# ── SMS for visitor verification codes ───────────────────────────
# disabled → visitors register through gate security (staff-assisted) until SMS is configured
# twilio   → fill in the Twilio values below
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ── Push notifications (optional) ─────────────────────────────────
# none | expo   (expo requires the mobile app to be built with an EAS project id)
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=

# ── Optional ──────────────────────────────────────────────────────
# One-time web setup of the first administrator at https://DOMAIN/setup (≥ 32 characters).
# Prefer the command-line option in the guide; remove this value after the first admin exists.
SETUP_TOKEN=
STAFF_SESSION_IDLE_HOURS=12
STAFF_SESSION_MAX_DAYS=7
VISITOR_SESSION_MAX_DAYS=30
MAINTENANCE_INTERVAL_SECONDS=60
# Mobile app links (after building the apps): see the main README.
IOS_APP_IDS=
ANDROID_PACKAGE=
ANDROID_SHA256_CERT_FINGERPRINTS=
