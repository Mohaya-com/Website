# Copy to `.env` in the repository root:  cp .env.example .env
# Never commit real credentials. All values below are placeholders / local-development defaults.

# ─────────────────────────────── Database ───────────────────────────────
DATABASE_URL=postgres://vms:vms_dev_password@localhost:5432/vms
# Used only by the automated tests (the test suite truncates its tables).
TEST_DATABASE_URL=postgres://vms:vms_dev_password@localhost:5432/vms_test
# Max connections per server process.
DATABASE_POOL_MAX=10

# ─────────────────────────────── Application ────────────────────────────
# Public origin of the web app. Used for CSRF origin checks and for the links encoded in QR codes.
APP_ORIGIN=http://localhost:3000
# Optional comma-separated list of additional allowed browser origins.
ADDITIONAL_ORIGINS=
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# ─────────────────────────────── Secrets ────────────────────────────────
# REQUIRED in production. Generate each one separately, e.g.:  openssl rand -base64 48
# In development, missing values fall back to clearly-labelled insecure dev keys (with a warning).
# HMAC key used to derive QR pass tokens. Rotating it invalidates every issued pass.
PASS_TOKEN_SECRET=
# HMAC key used to hash OTP codes, identity numbers used as rate-limit keys, and client IPs.
OTP_SECRET=
# Optional. Enables the one-time web setup page (/setup) for the first administrator.
# Must be at least 32 characters. Remove it after the first administrator is created.
SETUP_TOKEN=

# ─────────────────────────────── SMS / OTP ──────────────────────────────
# dev     → development only: codes are NOT sent; they are printed in the server log and shown at /dev/otp.
#           Refused at startup when NODE_ENV=production.
# twilio  → sends SMS through Twilio's REST API (credentials below).
# disabled→ visitor self-service sign-in is unavailable; staff-assisted registration still works.
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender number in E.164 format or a Messaging Service SID.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ─────────────────────────────── Push notifications ─────────────────────
# none → in-app notifications only.  expo → Expo Push Service (requires an EAS project in the mobile app).
PUSH_PROVIDER=none
# Optional Expo access token when "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# ─────────────────────────────── Sessions ───────────────────────────────
STAFF_SESSION_IDLE_HOURS=12
STAFF_SESSION_MAX_DAYS=7
VISITOR_SESSION_MAX_DAYS=30

# ─────────────────────────────── Background maintenance ─────────────────
# Interval (seconds) for expiring passes, auto-cancelling stale requests and flagging overdue visitors.
MAINTENANCE_INTERVAL_SECONDS=60
# Set to true to disable the in-process loop and run `pnpm maintenance` from an external scheduler instead.
VMS_DISABLE_MAINTENANCE=false

# ─────────────────────────────── Mobile app links (served by the web app) ─────
# iOS universal links: comma-separated "TEAMID.bundle.id" values for /.well-known/apple-app-site-association
IOS_APP_IDS=
# Android app links: package name and comma-separated SHA-256 signing certificate fingerprints for /.well-known/assetlinks.json
ANDROID_PACKAGE=
ANDROID_SHA256_CERT_FINGERPRINTS=

# ─────────────────────────────── Development seed ───────────────────────
# Passwords for the demo staff accounts created by `pnpm db:seed` (development only; the seed refuses to run in production).
SEED_ADMIN_PASSWORD=Admin-demo-2026!
SEED_SECURITY_PASSWORD=Guard-demo-2026!
